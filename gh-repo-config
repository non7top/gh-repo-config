#!/usr/bin/env bash
set -o errexit -o errtrace -o nounset -o pipefail

APP_NAME="$(basename "$0")"
APP_VERSION="1.0.0"
APP_CONFIG=".github/repo-config.json"
APP_CMD="help"
APP_ALLOW_DEFAULT_BRANCH_CHANGE="false"
APP_DRY_RUN="false"
APP_YES="false"

# `APP_ENV` is set by `make test`.
# `_GH` allows us to mock the `gh` binary in tests.
APP_ENV="${APP_ENV:-}"
if [ "${APP_ENV}" == "test" ]; then
    _GH="${_GH:-false}"
else
    _GH="gh"
fi

if ! command -v jq &>/dev/null; then
    echo "Error: jq is required but not installed. Install it from https://stedolan.github.io/jq/"
    exit 1
fi

log() {
    local -r msg="$1"
    printf "%s\n" "${msg}" >/dev/stderr
}

log:action() {
    local -r action="$1"
    local -r msg="$2"
    printf "[%8s]: %s\n" "${action}" "${msg}" >/dev/stderr
}

log:api() {
    local -r repo="$1"
    local -r msg="$2"
    printf "[%s]: %s\n" "${repo}" "${msg}" >/dev/stderr
}

# Send a mutating request. Body (optional) is JSON on stdin of `gh api`.
app::write() {
    local -r method="$1"
    local -r path="$2"
    local -r body="${3:-}"
    if [ "${APP_DRY_RUN}" = "true" ]; then
        log:action "dry-run" "${method} ${path}"
        return 0
    fi
    if [ -n "${body}" ]; then
        printf '%s' "${body}" | "${_GH}" api -X "${method}" "${path}" --input=- >/dev/null
    else
        "${_GH}" api -X "${method}" "${path}" >/dev/null
    fi
}

app::confirm() {
    local response
    while true; do
        read -r -p "${1:-Confirm?} [y/N]: " response
        case $response in
        [Yy]*) return 0 ;;
        [Nn]* | "") return 1 ;;
        *) echo "Please answer Y or N" ;;
        esac
    done
}

app::uri() {
    printf '%s' "$1" | jq -Rr '@uri'
}

app::require_config() {
    if [ ! -f "${APP_CONFIG}" ]; then
        log "Error: config file '${APP_CONFIG}' not found. Run '${APP_NAME} pull' to create it."
        exit 1
    fi
    if ! jq -e 'type == "object"' "${APP_CONFIG}" >/dev/null 2>&1; then
        log "Error: '${APP_CONFIG}' is not a valid JSON object."
        exit 1
    fi
}

# Is the named top-level section present in the config file?
app::has() {
    jq -e --arg key "$1" 'has($key)' "${APP_CONFIG}" >/dev/null
}

app::cfg() {
    jq -c "$1" "${APP_CONFIG}"
}

app::help() {
    echo "Manage GitHub repository settings via a declarative config file."
    echo ""
    echo "Usage:"
    echo "  gh repo-config <command> [<flags>]"
    echo ""
    echo "Commands:"
    echo "  pull:       Write the repo's live settings to the config file"
    echo "  push:       Apply the config file to the repo"
    echo "  sync:       Like push, but also delete labels, rulesets, environments and"
    echo "              branch protection that are not in the config file"
    echo ""
    echo "Examples:"
    echo "  $ gh repo-config pull"
    echo "  $ gh repo-config push --dry-run"
    echo "  $ gh repo-config sync"
    echo ""
    echo "  # Specifying an alternate config file:"
    echo "  $ gh repo-config pull --config ./repo-settings.json"
    echo ""
    echo "Options:"
    echo "  -c, --config <file>            Config file [default: ${APP_CONFIG}]."
    echo "  --allow-default-branch-change  Allow push to change the repo's default branch."
    echo "  --dry-run                      Print changes instead of making them."
    echo "  -y, --yes                      Do not ask for confirmation."
    echo "  -h, --help                     Show usage."
    echo "  -v, --version                  Show version."
    echo ""
}

# Transform GET /repos/{owner}/{repo}/branches/{branch}/protection response
# into the shape accepted by PUT (same endpoint).
# The GET response wraps boolean fields in objects; the PUT body wants flat booleans.
app::bp_get_to_put() {
    jq '{
        allow_force_pushes: (.allow_force_pushes.enabled // false),
        allow_deletions: (.allow_deletions.enabled // false),
        block_creations: (.block_creations.enabled // false),
        enforce_admins: (.enforce_admins.enabled // false),
        required_conversation_resolution: (.required_conversation_resolution.enabled // false),
        required_linear_history: (.required_linear_history.enabled // false),
        required_pull_request_reviews: (
            if .required_pull_request_reviews then {
                dismiss_stale_reviews: (.required_pull_request_reviews.dismiss_stale_reviews // false),
                require_code_owner_reviews: (.required_pull_request_reviews.require_code_owner_reviews // false),
                required_approving_review_count: (.required_pull_request_reviews.required_approving_review_count // 0),
                require_last_push_approval: (.required_pull_request_reviews.require_last_push_approval // false)
            } else null end
        ),
        required_signatures: (.required_signatures.enabled // false),
        required_status_checks: (
            if .required_status_checks then {
                strict: (.required_status_checks.strict // false),
                checks: (.required_status_checks.checks // [])
            } else null end
        ),
        restrictions: (
            if .restrictions then {
                users: [.restrictions.users[].login],
                teams: [.restrictions.teams[].slug],
                apps: [.restrictions.apps[].slug]
            } else null end
        )
    }'
}

# Transform GET /repos/{owner}/{repo}/environments response for one environment
# into the shape accepted by PUT /repos/{owner}/{repo}/environments/{name}.
app::env_get_to_put() {
    local -r env_name="$1"
    local -r envs_json="$2"
    printf '%s' "${envs_json}" | jq --arg name "${env_name}" '
        .environments[] | select(.name == $name) |
        {
            wait_timer: (reduce .protection_rules[] as $rule (null; if $rule.type == "wait_timer" then $rule.wait_timer else . end)),
            prevent_self_review: (reduce .protection_rules[] as $rule (false; if $rule.type == "prevent_self_review" then $rule.prevent_self_review else . end)),
            reviewers: ([.protection_rules[] | select(.type == "required_reviewers") | .reviewers[] | {type: .type, id: .reviewer.id}]),
            deployment_branch_policy: .deployment_branch_policy
        }
    '
}

# Transform GET /repos/{owner}/{repo}/rulesets/{id} response into the shape
# accepted by POST/PUT: drops ids, timestamps, links and other read-only fields.
app::ruleset_get_to_put() {
    jq '{name, target, enforcement, bypass_actors, conditions, rules} | with_entries(select(.value != null))'
}

# Keep only the writable fields of GET /repos/{owner}/{repo} (PATCH body).
app::repo_get_to_patch() {
    jq '{
        allow_auto_merge,
        allow_merge_commit,
        allow_rebase_merge,
        allow_squash_merge,
        allow_update_branch,
        default_branch,
        delete_branch_on_merge,
        description,
        has_discussions,
        has_issues,
        has_projects,
        has_wiki,
        homepage,
        merge_commit_message,
        merge_commit_title,
        security_and_analysis: (
            .security_and_analysis as $sa
            | if $sa then
                reduce (
                    "advanced_security", "dependabot_security_updates", "secret_scanning",
                    "secret_scanning_push_protection", "secret_scanning_non_provider_patterns",
                    "secret_scanning_validity_checks"
                ) as $key ({}; if $sa[$key] then .[$key] = {status: $sa[$key].status} else . end)
              else null end
        ),
        squash_merge_commit_message,
        squash_merge_commit_title,
        web_commit_signoff_required
    } | with_entries(select(.value != null))'
}

app::pull() {
    log "Pulling settings..."

    local repo_info default_branch repo_private
    repo_info=$("${_GH}" api /repos/:owner/:repo)
    default_branch=$(printf '%s' "${repo_info}" | jq -r '.default_branch')
    repo_private=$(printf '%s' "${repo_info}" | jq -r '.private')

    local repo_json topics_json labels_json
    repo_json=$(printf '%s' "${repo_info}" | app::repo_get_to_patch)
    topics_json=$("${_GH}" api /repos/:owner/:repo/topics | jq '{names}')
    labels_json=$("${_GH}" api /repos/:owner/:repo/labels --paginate | \
        jq -s 'add // [] | [.[] | {name, color, description: (.description // "")}]')

    # Branch protection and rulesets are unavailable on private repos (free plan);
    # the sections are left out so push and sync leave them alone.
    local bp_json="null" rulesets_json="null"
    if [ "${repo_private}" = "true" ]; then
        log:action "warn" "Skipping branch protection and rulesets: unavailable on private repos"
    else
        bp_json="{}"
        local branch
        while IFS= read -r branch; do
            [ -n "${branch}" ] || continue
            local bp_raw
            if bp_raw=$("${_GH}" api "/repos/:owner/:repo/branches/${branch}/protection" 2>/dev/null); then
                bp_json=$(jq --arg branch "${branch}" --argjson value "$(printf '%s' "${bp_raw}" | app::bp_get_to_put)" \
                    '.[$branch] = $value' <<<"${bp_json}")
            fi
        done < <("${_GH}" api /repos/:owner/:repo/branches --paginate --jq '.[] | select(.protected) | .name')

        rulesets_json="[]"
        local rulesets_list ruleset_id
        rulesets_list=$("${_GH}" api "/repos/:owner/:repo/rulesets?includes_parents=false" 2>/dev/null) || rulesets_list=""
        while IFS= read -r ruleset_id; do
            [ -n "${ruleset_id}" ] || continue
            local ruleset_raw
            ruleset_raw=$("${_GH}" api "/repos/:owner/:repo/rulesets/${ruleset_id}")
            rulesets_json=$(jq --argjson value "$(printf '%s' "${ruleset_raw}" | app::ruleset_get_to_put)" \
                '. + [$value]' <<<"${rulesets_json}")
        done < <(printf '%s' "${rulesets_list}" | jq -r '.[].id // empty')
    fi

    local environments_json="{}" envs_response=""
    if envs_response=$("${_GH}" api /repos/:owner/:repo/environments 2>/dev/null); then
        local env_name
        while IFS= read -r env_name; do
            [ -n "${env_name}" ] || continue
            environments_json=$(jq --arg name "${env_name}" \
                --argjson value "$(app::env_get_to_put "${env_name}" "${envs_response}")" \
                '.[$name] = $value' <<<"${environments_json}")
        done < <(printf '%s' "${envs_response}" | jq -r '.environments[].name')
    fi

    local actions_json="null" actions_perm actions_workflow
    actions_perm=$("${_GH}" api /repos/:owner/:repo/actions/permissions 2>/dev/null) || actions_perm=""
    actions_workflow=$("${_GH}" api /repos/:owner/:repo/actions/permissions/workflow 2>/dev/null) || actions_workflow=""
    if [ -n "${actions_perm}" ] && [ -n "${actions_workflow}" ]; then
        actions_json=$(jq -n --argjson perm "${actions_perm}" --argjson wf "${actions_workflow}" '{
            permissions: {enabled: $perm.enabled, allowed_actions: $perm.allowed_actions},
            workflow: {
                default_workflow_permissions: $wf.default_workflow_permissions,
                can_approve_pull_request_reviews: $wf.can_approve_pull_request_reviews
            }
        } | del(..|nulls)')
    fi

    # The vulnerability-alerts endpoint has no body: 204 means enabled, 404 disabled.
    local alerts_enabled="false"
    if "${_GH}" api /repos/:owner/:repo/vulnerability-alerts >/dev/null 2>&1; then
        alerts_enabled="true"
    fi

    local doc
    doc=$(jq -n \
        --argjson repo "${repo_json}" \
        --argjson topics "${topics_json}" \
        --argjson branch_protection "${bp_json}" \
        --argjson rulesets "${rulesets_json}" \
        --argjson labels "${labels_json}" \
        --argjson environments "${environments_json}" \
        --argjson actions "${actions_json}" \
        --argjson vulnerability_alerts "${alerts_enabled}" \
        '{
            repo: $repo,
            topics: $topics,
            branch_protection: $branch_protection,
            rulesets: $rulesets,
            labels: $labels,
            environments: $environments,
            actions: $actions,
            vulnerability_alerts: $vulnerability_alerts
        } | with_entries(select(.value != null))')

    # Every section gets an "x-comment-<section>" sibling: user-written comments
    # survive a pull, new ones default to the section's API docs link.
    local old_comments="{}"
    if [ -f "${APP_CONFIG}" ]; then
        old_comments=$(jq -c 'with_entries(select(.key | startswith("x-comment-")))' "${APP_CONFIG}")
    fi
    doc=$(jq --argjson old "${old_comments}" '
        {
            repo: "https://docs.github.com/en/rest/repos/repos#update-a-repository",
            topics: "https://docs.github.com/en/rest/repos/repos#replace-all-repository-topics",
            branch_protection: "https://docs.github.com/en/rest/branches/branch-protection#update-branch-protection",
            rulesets: "https://docs.github.com/en/rest/repos/rules#update-a-repository-ruleset",
            labels: "https://docs.github.com/en/rest/issues/labels",
            environments: "https://docs.github.com/en/rest/deployments/environments#create-or-update-an-environment",
            actions: "https://docs.github.com/en/rest/actions/permissions",
            vulnerability_alerts: "https://docs.github.com/en/rest/repos/repos#enable-vulnerability-alerts"
        } as $defaults
        | . as $doc
        | reduce ($doc | keys_unsorted[]) as $key ({};
            ("x-comment-" + $key) as $ckey
            | ($old[$ckey] // $defaults[$key]) as $comment
            | (if $comment == null then . else .[$ckey] = $comment end)
            | .[$key] = $doc[$key])' <<<"${doc}")

    if [ -f "${APP_CONFIG}" ]; then
        # The hunk header shows the nearest preceding x-comment, i.e. the changed section's comment.
        if diff -u --show-function-line='^  "x-comment-' "${APP_CONFIG}" <(printf '%s\n' "${doc}") >/dev/stderr; then
            log:action "keep" "${APP_CONFIG} (unchanged)"
            return 0
        fi
        if [ "${APP_DRY_RUN}" = "true" ]; then
            log:action "dry-run" "would replace ${APP_CONFIG}"
            return 0
        fi
        if [ "${APP_YES}" != "true" ] && ! app::confirm "Overwrite ${APP_CONFIG}?"; then
            log:action "keep" "${APP_CONFIG}"
            return 0
        fi
        log:action "replace" "${APP_CONFIG}"
    else
        if [ "${APP_DRY_RUN}" = "true" ]; then
            log:action "dry-run" "would create ${APP_CONFIG}"
            return 0
        fi
        log:action "create" "${APP_CONFIG}"
        mkdir -p "$(dirname "${APP_CONFIG}")"
    fi
    printf '%s\n' "${doc}" >"${APP_CONFIG}"
    log "Done"
}

# Print "<api path><TAB><description>" for everything live that the config file
# manages (section present) but does not list.
app::prune_plan() {
    local -r repo_private="$1"

    if app::has labels; then
        local name
        while IFS= read -r name; do
            [ -n "${name}" ] || continue
            printf '/repos/:owner/:repo/labels/%s\tlabel %s\n' "$(app::uri "${name}")" "${name}"
        done < <(comm -23 \
            <("${_GH}" api /repos/:owner/:repo/labels --paginate --jq '.[].name' | sort) \
            <(jq -r '.labels[].name' "${APP_CONFIG}" | sort))
    fi

    if [ "${repo_private}" != "true" ] && app::has rulesets; then
        local rulesets_list ruleset_name
        rulesets_list=$("${_GH}" api "/repos/:owner/:repo/rulesets?includes_parents=false")
        while IFS=$'\t' read -r ruleset_id ruleset_name; do
            [ -n "${ruleset_id}" ] || continue
            if ! jq -e --arg name "${ruleset_name}" 'any(.rulesets[]; .name == $name)' "${APP_CONFIG}" >/dev/null; then
                printf '/repos/:owner/:repo/rulesets/%s\truleset %s\n' "${ruleset_id}" "${ruleset_name}"
            fi
        done < <(printf '%s' "${rulesets_list}" | jq -r '.[] | [.id, .name] | @tsv')
    fi

    if app::has environments; then
        local envs_response
        envs_response=$("${_GH}" api /repos/:owner/:repo/environments)
        while IFS= read -r name; do
            [ -n "${name}" ] || continue
            if ! jq -e --arg name "${name}" '.environments | has($name)' "${APP_CONFIG}" >/dev/null; then
                printf '/repos/:owner/:repo/environments/%s\tenvironment %s\n' "$(app::uri "${name}")" "${name}"
            fi
        done < <(printf '%s' "${envs_response}" | jq -r '.environments[].name')
    fi

    if [ "${repo_private}" != "true" ] && app::has branch_protection; then
        while IFS= read -r name; do
            [ -n "${name}" ] || continue
            if ! jq -e --arg name "${name}" '.branch_protection | has($name)' "${APP_CONFIG}" >/dev/null; then
                printf '/repos/:owner/:repo/branches/%s/protection\tbranch protection %s\n' "${name}" "${name}"
            fi
        done < <("${_GH}" api /repos/:owner/:repo/branches --paginate --jq '.[] | select(.protected) | .name')
    fi
}

app::push() {
    local prune="${1:-false}"
    app::require_config

    local repo repo_meta live_default_branch repo_private
    repo=$("${_GH}" repo view --json nameWithOwner --jq .nameWithOwner)
    # Branch names can't contain spaces, so a space-separated pair is safe.
    repo_meta=$("${_GH}" api /repos/:owner/:repo --jq '.default_branch + " " + (.private | tostring)')
    read -r live_default_branch repo_private <<<"${repo_meta}"

    local plan=""
    if [ "${prune}" = "true" ]; then
        plan=$(app::prune_plan "${repo_private}")
        if [ -n "${plan}" ]; then
            log "The following live resources are not in ${APP_CONFIG} and will be deleted:"
            while IFS=$'\t' read -r _ description; do
                log "  - ${description}"
            done <<<"${plan}"
            if [ "${APP_DRY_RUN}" != "true" ] && [ "${APP_YES}" != "true" ] && ! app::confirm "Delete these?"; then
                log "Aborted."
                return 1
            fi
        fi
    fi

    if app::has repo; then
        log:api "${repo}" "Configuring repo"
        local repo_body config_default_branch
        repo_body=$(app::cfg '.repo')
        config_default_branch=$(jq -r '.default_branch // empty' <<<"${repo_body}")
        if [ -n "${config_default_branch}" ] && [ "${config_default_branch}" != "${live_default_branch}" ]; then
            if [ "${APP_ALLOW_DEFAULT_BRANCH_CHANGE}" != "true" ]; then
                log "ERROR: default_branch in repo ('${config_default_branch}') differs from live ('${live_default_branch}')."
                log "  Refusing to change default branch without explicit opt-in."
                log "  Run with --allow-default-branch-change to allow this change."
                log "  Applying remaining repo fields without default_branch."
                repo_body=$(jq -c 'del(.default_branch)' <<<"${repo_body}")
            else
                log:api "${repo}" "Changing default branch: '${live_default_branch}' -> '${config_default_branch}'"
            fi
        fi
        app::write PATCH /repos/:owner/:repo "${repo_body}"
    fi

    if app::has topics; then
        log:api "${repo}" "Configuring repo topics"
        app::write PUT /repos/:owner/:repo/topics "$(app::cfg '.topics')"
    fi

    if app::has branch_protection; then
        if [ "${repo_private}" = "true" ]; then
            log:action "warn" "Skipping branch protection: unavailable on private repos"
        else
            local branch
            while IFS= read -r branch; do
                [ -n "${branch}" ] || continue
                log:api "${repo}" "Configuring branch protection rules for '${branch}'"
                app::write PUT "/repos/:owner/:repo/branches/${branch}/protection" \
                    "$(jq -c --arg branch "${branch}" '.branch_protection[$branch]' "${APP_CONFIG}")"
            done < <(jq -r '.branch_protection | keys[]' "${APP_CONFIG}")
        fi
    fi

    if app::has rulesets; then
        if [ "${repo_private}" = "true" ]; then
            log:action "warn" "Skipping rulesets: unavailable on private repos"
        else
            local existing_rulesets index count
            existing_rulesets=$("${_GH}" api "/repos/:owner/:repo/rulesets?includes_parents=false")
            count=$(jq '.rulesets | length' "${APP_CONFIG}")
            for ((index = 0; index < count; index++)); do
                local ruleset_body ruleset_name ruleset_id
                ruleset_body=$(jq -c --argjson i "${index}" '.rulesets[$i]' "${APP_CONFIG}")
                ruleset_name=$(jq -r '.name' <<<"${ruleset_body}")
                ruleset_id=$(printf '%s' "${existing_rulesets}" | \
                    jq -r --arg name "${ruleset_name}" 'first(.[] | select(.name == $name) | .id) // empty')
                log:api "${repo}" "Configuring ruleset '${ruleset_name}'"
                if [ -n "${ruleset_id}" ]; then
                    app::write PUT "/repos/:owner/:repo/rulesets/${ruleset_id}" "${ruleset_body}"
                else
                    app::write POST /repos/:owner/:repo/rulesets "${ruleset_body}"
                fi
            done
        fi
    fi

    if app::has labels; then
        log:api "${repo}" "Configuring labels"
        local label_json label_name encoded_name
        while IFS= read -r label_json; do
            label_name=$(jq -r '.name' <<<"${label_json}")
            encoded_name=$(app::uri "${label_name}")
            if "${_GH}" api "/repos/:owner/:repo/labels/${encoded_name}" >/dev/null 2>&1; then
                app::write PATCH "/repos/:owner/:repo/labels/${encoded_name}" "${label_json}"
            else
                app::write POST /repos/:owner/:repo/labels "${label_json}"
            fi
        done < <(jq -c '.labels[]' "${APP_CONFIG}")
    fi

    if app::has environments; then
        local env_name
        while IFS= read -r env_name; do
            [ -n "${env_name}" ] || continue
            log:api "${repo}" "Configuring environment '${env_name}'"
            app::write PUT "/repos/:owner/:repo/environments/$(app::uri "${env_name}")" \
                "$(jq -c --arg name "${env_name}" '.environments[$name]' "${APP_CONFIG}")"
        done < <(jq -r '.environments | keys[]' "${APP_CONFIG}")
    fi

    if app::has actions; then
        log:api "${repo}" "Configuring Actions permissions"
        if jq -e '.actions | has("permissions")' "${APP_CONFIG}" >/dev/null; then
            app::write PUT /repos/:owner/:repo/actions/permissions "$(app::cfg '.actions.permissions')"
        fi
        if jq -e '.actions | has("workflow")' "${APP_CONFIG}" >/dev/null; then
            app::write PUT /repos/:owner/:repo/actions/permissions/workflow "$(app::cfg '.actions.workflow')"
        fi
    fi

    if app::has vulnerability_alerts; then
        log:api "${repo}" "Configuring vulnerability alerts"
        if [ "$(jq -r '.vulnerability_alerts' "${APP_CONFIG}")" = "true" ]; then
            app::write PUT /repos/:owner/:repo/vulnerability-alerts
        else
            app::write DELETE /repos/:owner/:repo/vulnerability-alerts
        fi
    fi

    if [ -n "${plan}" ]; then
        local path
        while IFS=$'\t' read -r path description; do
            log:api "${repo}" "Deleting ${description}"
            app::write DELETE "${path}"
        done <<<"${plan}"
    fi
}

app::sync() {
    app::push true
}

app::unknown() {
    local -r arg="$1"
    echo "Unknown argument '${arg}'"
}

app::version() {
    echo "${APP_NAME} version ${APP_VERSION}"
}

app::parseargs() {
    while test $# -gt 0; do
        case "${1}" in
        pull | push | sync | help | version)
            APP_CMD="${1}"
            shift
            ;;
        -c | --config)
            APP_CONFIG="${2:?empty config path not allowed}"
            shift 2
            ;;
        --allow-default-branch-change)
            APP_ALLOW_DEFAULT_BRANCH_CHANGE="true"
            shift
            ;;
        --dry-run)
            APP_DRY_RUN="true"
            shift
            ;;
        -y | --yes)
            APP_YES="true"
            shift
            ;;
        -h | --help)
            APP_CMD="help"
            shift
            ;;
        --version)
            APP_CMD="version"
            shift
            ;;
        *)
            app::unknown "$1"
            exit 1
            ;;
        esac
    done
}

app::dispatch() {
    case "${1}" in
    pull) app::pull ;;
    push) app::push ;;
    sync) app::sync ;;
    help) app::help ;;
    version) app::version ;;
    esac
}

app::parseargs "$@"
app::dispatch "$APP_CMD"
